:root{
  --bg1:#061427;
  --bg2:#071f37;
  --glass: rgba(255,255,255,.08);
  --glass2: rgba(255,255,255,.12);
  --stroke: rgba(255,255,255,.14);
  --text: rgba(255,255,255,.92);
  --muted: rgba(255,255,255,.62);
  --muted2: rgba(255,255,255,.45);
  --shadow: 0 18px 60px rgba(0,0,0,.35);
  --r: 18px;
}

*{box-sizing:border-box}
html,body{height:100%}
body{
  margin:0;
  font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial;
  color: var(--text);
  background: radial-gradient(1200px 700px at 20% 20%, #0a3b66 0%, transparent 55%),
              radial-gradient(900px 700px at 70% 10%, #14325a 0%, transparent 55%),
              linear-gradient(180deg, var(--bg1), var(--bg2));
}

.bg{
  min-height: 100%;
  padding: 22px;
}

.shell{
  max-width: 1300px;
  margin: 0 auto;
}

.glass{
  background: var(--glass);
  border: 1px solid var(--stroke);
  border-radius: var(--r);
  box-shadow: var(--shadow);
  backdrop-filter: blur(10px);
}

.topbar{
  display:flex;
  gap: 14px;
  align-items:center;
  padding: 14px 16px;
}

.brand{
  display:flex;
  gap: 12px;
  align-items:center;
  min-width: 220px;
}
.dot{
  width: 12px; height: 12px; border-radius: 50%;
  background: rgba(140,220,255,.85);
  box-shadow: 0 0 18px rgba(140,220,255,.65);
}
.brand-title{font-size: 20px; font-weight: 800; letter-spacing:.2px}
.brand-sub{font-size: 12px; color: var(--muted2); margin-top:2px}

.search{
  flex:1;
  display:flex;
  align-items:center;
  gap: 10px;
  padding: 10px 12px;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,.12);
  background: rgba(0,0,0,.14);
}
.search input{
  width: 100%;
  border:none;
  outline:none;
  background: transparent;
  color: var(--text);
  font-size: 14px;
}
.icon-btn{
  width: 34px; height: 34px;
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,.14);
  background: rgba(255,255,255,.06);
  color: var(--text);
  cursor:pointer;
}
.icon-btn:hover{background: rgba(255,255,255,.1)}

.top-kpis{
  display:flex;
  gap: 12px;
  align-items:center;
}
.mini-kpi{
  padding: 6px 10px;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,.12);
  background: rgba(0,0,0,.12);
  min-width: 160px;
}
.mini-label{font-size: 11px; color: var(--muted2)}
.mini-value{font-weight: 800; font-size: 18px; margin-top:3px}

.mini-pill{
  display:flex;
  gap: 8px;
  align-items:center;
  padding: 10px 12px;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,.12);
  background: rgba(0,0,0,.12);
  font-size: 12px;
  color: var(--text);
  white-space: nowrap;
}
.pill-ico{opacity:.9}

.grid{
  margin-top: 14px;
  display:grid;
  gap: 14px;
  grid-template-columns: 1.05fr 1.7fr 1.1fr 1.1fr;
  grid-auto-rows: minmax(140px, auto);
}

.card{
  padding: 14px;
  position:relative;
  overflow:hidden;
}
.card-head{
  display:flex;
  align-items:center;
  justify-content: space-between;
  margin-bottom: 12px;
}
.card-title{font-weight: 800; letter-spacing:.2px}
.badge{
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(255,184,77,.14);
  border: 1px solid rgba(255,184,77,.25);
  color: rgba(255,220,180,.95);
  font-size: 12px;
}
.chip{
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(255,255,255,.08);
  border: 1px solid rgba(255,255,255,.14);
  color: var(--text);
  font-size: 12px;
}
.chip.up{
  background: rgba(140,255,200,.10);
  border-color: rgba(140,255,200,.22);
}

.tall{grid-row: span 2;}
.hero{grid-row: span 2; grid-column: span 1;}
.wide{grid-column: span 2;}

.row{
  display:flex;
  gap: 14px;
  align-items:center;
  justify-content: space-between;
}
.big-number .num{
  font-size: 44px;
  font-weight: 900;
  line-height: 1;
}
.muted{color: var(--muted)}
.small{font-size: 12px}

.gauge-wrap{
  position:relative;
  width: 220px;
  height: 220px;
}
.gauge-center{
  position:absolute;
  inset: 0;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
  pointer-events:none;
}
.gauge-value{font-weight: 900; font-size: 24px}

.divider{
  height:1px;
  background: rgba(255,255,255,.12);
  margin: 14px 0;
}

.list{display:flex; flex-direction:column; gap: 10px}
.list-item{
  display:flex; align-items:center; gap: 10px;
  padding: 10px 12px;
  border-radius: 14px;
  background: rgba(0,0,0,.12);
  border: 1px solid rgba(255,255,255,.10);
}
.list-item .right{margin-left:auto; font-weight: 700}
.dot{width: 10px; height: 10px; border-radius: 50%}
.dot.ok{background: rgba(140,255,200,.85)}
.dot.warn{background: rgba(255,200,120,.9)}
.dot.bad{background: rgba(255,120,120,.9)}

.tiny-note{margin-top: 12px}

.hero-inner{
  display:flex;
  flex-direction:column;
  gap: 10px;
  height:100%;
}
.hero-title{font-size: 18px; font-weight: 900}
.hero-sub{font-size: 12px}
.hero-ship{
  flex:1;
  min-height: 260px;
  border-radius: 16px;
  background: radial-gradient(800px 280px at 40% 30%, rgba(140,220,255,.22), transparent 60%),
              linear-gradient(180deg, rgba(0,0,0,.14), rgba(0,0,0,.08));
  border: 1px solid rgba(255,255,255,.10);
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
}
.hero-ship svg{width: 90%; opacity: .95; filter: drop-shadow(0 18px 20px rgba(0,0,0,.35));}

.mini-panel{
  padding: 12px;
  border-radius: 16px;
  background: rgba(255,255,255,.07);
  border: 1px solid rgba(255,255,255,.12);
}
.mini-panel-title{font-weight: 800; font-size: 12px; margin-bottom: 8px}

.progress{
  height: 10px;
  border-radius: 999px;
  background: rgba(255,255,255,.10);
  overflow:hidden;
  border: 1px solid rgba(255,255,255,.12);
}
.progress.big{height: 14px}
.progress-bar{
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, rgba(140,220,255,.9), rgba(140,255,200,.85));
  border-radius: 999px;
}
.progress-foot{
  display:flex;
  justify-content: space-between;
  margin-top: 8px;
}

.fish-name{font-weight: 900; font-size: 18px}
.kv{display:flex; gap: 14px; margin-top: 10px}
.kv-item{
  flex:1;
  padding: 10px 12px;
  border-radius: 14px;
  background: rgba(0,0,0,.12);
  border: 1px solid rgba(255,255,255,.10);
}
.kv-val{font-weight: 900; margin-top: 4px}

.meter .meter-label{
  display:flex;
  justify-content: space-between;
  margin-bottom: 8px;
  font-size: 12px;
  color: var(--muted);
}
.btn{
  width: 100%;
  margin-top: 10px;
  padding: 10px 12px;
  border-radius: 14px;
  border: 1px solid rgba(255,255,255,.14);
  background: rgba(255,255,255,.10);
  color: var(--text);
  font-weight: 700;
  cursor:pointer;
}
.btn.ghost{background: rgba(0,0,0,.10)}
.btn:hover{background: rgba(255,255,255,.14)}

.capture-value{
  font-size: 28px;
  font-weight: 900;
  margin-bottom: 12px;
}
.seg{
  display:flex;
  gap: 8px;
  margin: 10px 0 12px;
}
.seg-btn{
  flex:1;
  padding: 9px 10px;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,.14);
  background: rgba(0,0,0,.10);
  color: var(--text);
  font-size: 12px;
  cursor:pointer;
}
.seg-btn.active{
  background: rgba(140,220,255,.16);
  border-color: rgba(140,220,255,.25);
}

.breakdown{
  display:grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-top: 8px;
}
.break{
  padding: 10px 12px;
  border-radius: 14px;
  background: rgba(0,0,0,.12);
  border: 1px solid rgba(255,255,255,.10);
}
.break .label{font-size: 11px; color: var(--muted2)}
.break .val{font-weight: 900; margin-top: 4px}

.filters{display:flex; gap: 10px}
select{
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,.14);
  background: rgba(0,0,0,.12);
  color: var(--text);
  padding: 8px 10px;
  outline:none;
}

.captains{
  display:grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}
.cap{
  padding: 12px;
  border-radius: 16px;
  background: rgba(0,0,0,.12);
  border: 1px solid rgba(255,255,255,.10);
  display:flex;
  gap: 12px;
  align-items:center;
}
.avatar{
  width: 44px; height: 44px;
  border-radius: 14px;
  background: rgba(140,220,255,.18);
  border: 1px solid rgba(140,220,255,.25);
  display:flex; align-items:center; justify-content:center;
  font-weight: 900;
}
.cap .name{font-weight: 900}
.cap .meta{font-size: 12px; color: var(--muted2); margin-top: 3px}
.cap .right{
  margin-left:auto;
  text-align:right;
}
.pill{
  display:inline-block;
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 12px;
  border: 1px solid rgba(255,255,255,.14);
  background: rgba(255,255,255,.08);
}
.pill.ok{border-color: rgba(140,255,200,.25); background: rgba(140,255,200,.10)}
.pill.warn{border-color: rgba(255,200,120,.25); background: rgba(255,200,120,.10)}

.radar{
  display:flex;
  gap: 12px;
  align-items: stretch;
}
.radar-left{
  width: 240px;
  padding: 12px;
  border-radius: 16px;
  background: rgba(0,0,0,.12);
  border: 1px solid rgba(255,255,255,.10);
}
.radar-title{font-weight: 900; font-size: 18px; margin-top: 4px}
.tiny-kv{display:flex; justify-content:space-between; margin-top: 12px}
.radar-screen{
  flex: 1;
  border-radius: 16px;
  background: radial-gradient(380px 220px at 40% 40%, rgba(140,220,255,.20), transparent 60%),
              linear-gradient(180deg, rgba(0,0,0,.12), rgba(0,0,0,.06));
  border: 1px solid rgba(255,255,255,.10);
  display:flex; align-items:center; justify-content:center;
  overflow:hidden;
}
.radar-screen canvas{width: 100%; height: 100%}

.foot{
  margin-top: 12px;
  text-align:center;
  opacity:.85;
}

@media (max-width: 1200px){
  .grid{grid-template-columns: 1fr 1fr; }
  .wide{grid-column: span 2;}
  .hero{grid-column: span 2;}
}
@media (max-width: 720px){
  .topbar{flex-direction:column; align-items:stretch}
  .top-kpis{flex-wrap:wrap; justify-content:space-between}
  .grid{grid-template-columns: 1fr;}
  .wide,.hero,.tall{grid-column: span 1; grid-row: auto;}
  .captains{grid-template-columns: 1fr;}
  .radar{flex-direction:column}
  .radar-left{width: 100%}
}