<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Marine Dashboard Prototype</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="./styles.css" />

  <!-- Charts -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
</head>

<body>
  <div class="bg">
    <div class="shell">
      <!-- Top Bar -->
      <header class="topbar glass">
        <div class="brand">
          <div class="dot"></div>
          <div>
            <div class="brand-title">Dashboard</div>
            <div class="brand-sub">Marine Fleet • Prototype</div>
          </div>
        </div>

        <div class="search">
          <input id="searchInput" placeholder="How can I help you?" />
          <button class="icon-btn" title="Send">
            <span>➤</span>
          </button>
          <button class="icon-btn" title="Voice">
            <span>🎙</span>
          </button>
        </div>

        <div class="top-kpis">
            <button class="icon-btn" id="logoutBtn" title="Logout">
  <span>⎋</span>
</button>
          <div class="mini-kpi">
            <div class="mini-label">Sales this month</div>
            <div class="mini-value" id="kpiSales">$0</div>
          </div>
          <div class="mini-kpi">
            <div class="mini-label">Everyday performance</div>
            <div class="mini-value" id="kpiPerf">0%</div>
          </div>
          <div class="mini-pill">
            <span class="pill-ico">📍</span>
            <span id="kpiPort">Port</span>
          </div>
          <div class="mini-pill">
            <span class="pill-ico">🌡</span>
            <span id="kpiTemp">--°F</span>
          </div>
        </div>
      </header>

      <!-- Main Grid -->
      <main class="grid">
        <!-- Left: Active ships + Capacity gauge -->
        <section class="card glass tall">
          <div class="card-head">
            <div class="card-title">Active Ships</div>
            <div class="badge" id="alertsBadge">Alerts 0</div>
          </div>

          <div class="row">
            <div class="big-number">
              <div class="num" id="activeShips">0</div>
              <div class="muted">active / total</div>
              <div class="muted small" id="activeShipsSub">0 / 0</div>
            </div>

            <div class="gauge-wrap">
              <canvas id="capacityGauge" width="220" height="220"></canvas>
              <div class="gauge-center">
                <div class="gauge-value" id="capacityPct">0%</div>
                <div class="muted small">Capacity used</div>
                <div class="muted small" id="capacityTons">0 t</div>
              </div>
            </div>
          </div>

          <div class="divider"></div>

          <div class="list">
            <div class="list-item">
              <span class="dot ok"></span>
              <span>Practicable</span>
              <span class="right" id="statPracticable">0</span>
            </div>
            <div class="list-item">
              <span class="dot warn"></span>
              <span>Restricted capacity</span>
              <span class="right" id="statRestricted">0</span>
            </div>
            <div class="list-item">
              <span class="dot bad"></span>
              <span>Out of service</span>
              <span class="right" id="statOut">0</span>
            </div>
          </div>

          <div class="tiny-note muted">
            Load info • Total capacity: <b id="totalCapacity">0</b> t
          </div>
        </section>

        <!-- Center: Hero Visual (placeholder) + mini capacity bar -->
        <section class="card glass hero">
          <div class="hero-inner">
            <div class="hero-title">Fleet Overview</div>
            <div class="hero-sub muted">Ocean operations • route & utilization</div>

            <div class="hero-ship">
              <!-- Simple SVG “ship” placeholder so you don’t need images -->
              <svg viewBox="0 0 520 220" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <linearGradient id="hull" x1="0" x2="1">
                    <stop offset="0" stop-color="rgba(255,255,255,.85)"/>
                    <stop offset="1" stop-color="rgba(255,255,255,.35)"/>
                  </linearGradient>
                </defs>
                <path d="M70 140 C120 120, 160 85, 240 90 C330 95, 390 70, 460 85
                         C470 120, 450 170, 380 185 C280 205, 160 200, 90 180
                         C70 170, 55 155, 70 140 Z"
                      fill="url(#hull)" opacity=".9"/>
                <path d="M190 85 L215 45 L320 45 L345 85 Z" fill="rgba(255,255,255,.45)"/>
                <circle cx="245" cy="128" r="7" fill="rgba(0,0,0,.25)"/>
                <circle cx="285" cy="128" r="7" fill="rgba(0,0,0,.25)"/>
                <path d="M460 90 C500 115, 510 130, 515 150" stroke="rgba(140,220,255,.45)" stroke-width="8" fill="none"/>
                <path d="M445 100 C485 125, 495 142, 500 160" stroke="rgba(140,220,255,.25)" stroke-width="12" fill="none"/>
              </svg>
            </div>

            <div class="mini-panel glass">
              <div class="mini-panel-title">Capacity on both ships</div>
              <div class="progress">
                <div class="progress-bar" id="bothShipsBar" style="width: 0%"></div>
              </div>
              <div class="progress-foot">
                <span class="muted small">Recovery</span>
                <span class="muted small" id="recoveryPct">0%</span>
              </div>
            </div>
          </div>
        </section>

        <!-- Right: AI Assistant / Fish card -->
        <section class="card glass">
          <div class="card-head">
            <div class="card-title">AI Assistant</div>
            <div class="chip">Rank #1</div>
          </div>

          <div class="fish">
            <div class="fish-name" id="fishName">Pacific Mackerel</div>
            <div class="muted small" id="fishMeta">Ocean-caught • Coral Sea</div>
            <div class="kv">
              <div class="kv-item">
                <div class="muted small">Market share</div>
                <div class="kv-val" id="fishShare">0%</div>
              </div>
              <div class="kv-item">
                <div class="muted small">Annual</div>
                <div class="kv-val" id="fishAnnual">0 tons</div>
              </div>
            </div>
          </div>

          <div class="divider"></div>

          <div class="meter">
            <div class="meter-label">
              <span>Sustainability rating</span>
              <span class="muted small" id="sustainScore">0/100</span>
            </div>
            <canvas id="sustainGauge" height="120"></canvas>
            <button class="btn ghost">View Details</button>
          </div>
        </section>

        <!-- Right: Today capture + breakdown -->
        <section class="card glass">
          <div class="card-head">
            <div class="card-title">Today's total capture</div>
            <div class="chip up" id="captureTrend">+0%</div>
          </div>

          <div class="capture">
            <div class="capture-value">
              <span id="captureNow">0</span>
              <span class="muted">/</span>
              <span class="muted" id="captureTarget">0</span>
              <span class="muted">Lb</span>
            </div>

            <div class="progress big">
              <div class="progress-bar" id="captureBar" style="width: 0%"></div>
            </div>

            <div class="muted small">By type</div>
            <div class="seg">
              <button class="seg-btn active" data-type="mackerel">Pacific Mackerel</button>
              <button class="seg-btn" data-type="salmon">Salmon</button>
              <button class="seg-btn" data-type="others">Others</button>
            </div>

            <div class="breakdown" id="typeBreakdown"></div>

            <button class="btn ghost">View Details</button>
          </div>
        </section>

        <!-- Bottom left: Captains -->
        <section class="card glass wide">
          <div class="card-head">
            <div class="card-title">Captains</div>
            <div class="filters">
              <select id="shiftSelect">
                <option value="all">Shift: All</option>
                <option value="day">Day</option>
                <option value="night">Night</option>
              </select>
              <select id="zoneSelect">
                <option value="all">Zone: All</option>
              </select>
            </div>
          </div>

          <div class="captains" id="captainsList"></div>
        </section>

        <!-- Bottom right: Map panel (simple radar-like mock) -->
        <section class="card glass wide">
          <div class="card-head">
            <div class="card-title">Tracking</div>
            <div class="chip" id="lastUpdate">Last 07d</div>
          </div>

          <div class="radar">
            <div class="radar-left">
              <div class="muted small">Active zone</div>
              <div class="radar-title" id="radarZone">Pacific</div>
              <div class="muted small" id="radarMeta">2 ships • 1 route</div>

              <div class="tiny-kv">
                <div>
                  <div class="muted small">Ocean</div>
                  <div class="kv-val" id="radarOcean">Coral Sea</div>
                </div>
                <div>
                  <div class="muted small">Annual</div>
                  <div class="kv-val" id="radarAnnual">0</div>
                </div>
              </div>
            </div>

            <div class="radar-screen">
              <canvas id="radarCanvas" width="520" height="220"></canvas>
            </div>
          </div>
        </section>
      </main>

      <footer class="foot muted small">
        Marine Fleet Operations • Live database data • API connected
      </footer>
    </div>
  </div>

  <script src="./session.js"></script>
<script src="./data.js"></script>
<script src="./app.js"></script>
</body>
</html>